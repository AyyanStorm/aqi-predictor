# Hopsworks Feature Store credentials (Day 7).
# Copy this file to .env (gitignored) and fill in real values.
# The same variables are injected as GitHub Actions Secrets on CI
# (Settings -> Secrets and variables -> Actions) — same names, no code change.
#
# Where to find each value (app.hopsworks.ai):
#   HOPSWORKS_API_KEY   -> account settings -> API keys -> create one
#   HOPSWORKS_PROJECT   -> the project name (shown top-left in the UI,
#                          also in the URL: .../p/<PROJECT_NAME>/...)
#   HOPSWORKS_HOST      -> your cluster domain; default is
#                          eu-west.cloud.hopsworks.ai (can omit)
#   HOPSWORKS_PORT      -> 443 (can omit)
HOPSWORKS_API_KEY=your_key_here
HOPSWORKS_PROJECT=your_project_name
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai
HOPSWORKS_PORT=443
