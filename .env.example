# ============================================================================
# AQI Predictor Environment Variables
# ============================================================================
# Copy this file to .env (gitignored) and fill in real values.
# The same variables are injected as GitHub Actions Secrets on CI
# (Settings -> Secrets and variables -> Actions) — same names, no code change.
#
# DO NOT COMMIT .env to version control. Use .env.example as a template.
# ============================================================================

# HOPSWORKS FEATURE STORE CREDENTIALS
# ============================================================================
# Where to find each value (app.hopsworks.ai):
#   HOPSWORKS_API_KEY   -> account settings -> API keys -> create one
#   HOPSWORKS_PROJECT   -> the project name (shown top-left in the UI,
#                          also in the URL: .../p/<PROJECT_NAME>/...)
#   HOPSWORKS_HOST      -> your cluster domain; default is
#                          eu-west.cloud.hopsworks.ai (can omit)
#   HOPSWORKS_PORT      -> 443 (can omit)
HOPSWORKS_API_KEY=your_key_here
HOPSWORKS_PROJECT=your_project_name
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai
HOPSWORKS_PORT=443

# API CONFIGURATION
# ============================================================================
# Enable/disable rate limiting
SLOWAPI_ENABLED=true

# Log format (json for machine parsing, text for human reading)
LOG_FORMAT=json

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# OPTIONAL: External URL for Render deployment
# Used for CORS and redirect URLs
# RENDER_EXTERNAL_URL=https://your-service.onrender.com

# OPTIONAL: Database URL (PostgreSQL)
# Only needed if using persistent prediction cache
# DATABASE_URL=postgresql://user:password@localhost:5432/aqi_predictor

# OPTIONAL: Redis cache URL
# Only needed for production caching (instead of .json file)
# REDIS_URL=redis://localhost:6379/0
