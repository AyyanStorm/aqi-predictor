# Grafana Configuration for AQI Predictor (Issue #46)
# Copy to .env.grafana and customize for your environment

# Admin credentials (change these in production!)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Server configuration
GF_SERVER_ROOT_URL=http://localhost:3000
GF_SERVER_DOMAIN=localhost

# Security
GF_SECURITY_DISABLE_BRUTE_FORCE_LOGIN_PROTECTION=false
GF_SECURITY_COOKIE_SECURE=false
GF_SECURITY_COOKIE_SAMESITE=lax

# Users
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_DEFAULT_ROLE=Viewer

# Logging
GF_LOG_MODE=console file
GF_LOG_LEVEL=info

# Session
GF_SESSION_PROVIDER=memory
GF_SESSION_PROVIDER_CONFIG=provider_config:memory

# Plugins (optional)
GF_INSTALL_PLUGINS=grafana-piechart-panel,grafana-worldmap-panel

# Auth (optional - enable if using OAuth/LDAP)
# GF_AUTH_GENERIC_OAUTH_ENABLED=false
# GF_AUTH_GENERIC_OAUTH_NAME=OAuth
# GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=
# GF_AUTH_GENERIC_OAUTH_SCOPES=profile email
# GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://example.com/oauth/authorize
# GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://example.com/oauth/token
# GF_AUTH_GENERIC_OAUTH_API_URL=https://example.com/oauth/userinfo
